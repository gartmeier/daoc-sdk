{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/setup-worktree.ts --hook",
            "timeout": 300,
            "statusMessage": "Setting up the worktree"
          }
        ]
      }
    ]
  }
}
