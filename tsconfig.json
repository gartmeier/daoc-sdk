{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "allowJs": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"]
  },
  "include": ["*.ts", "sdk/**/*.ts", "client/**/*.ts", "gateway/**/*.ts", "mcp/**/*.ts", "data/**/*.ts", "scripts/**/*.ts", "bots/**/*.ts", "groups/**/*.ts"],
  "exclude": ["node_modules", "reference", "server"]
}
