{
  "name": "daoc-sdk",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run test",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/check-submodules.ts && bun test ./sdk ./client ./gateway ./mcp ./data ./scripts ./bots",
    "setup:worktree": "bun scripts/setup-worktree.ts",
    "gateway": "bun gateway/gateway.ts",
    "client": "bun client/runner.ts",
    "mcp": "bun mcp/server.ts",
    "data:build": "bun scripts/build-data.ts",
    "docs:api": "bun sdk/generate-api-docs.ts",
    "docs:api:check": "bun sdk/generate-api-docs.ts --check",
    "server:up": "bun scripts/check-submodules.ts && docker compose -f server/docker/docker-compose.yml up -d --build",
    "server:down": "docker compose -f server/docker/docker-compose.yml down",
    "server:setup": "bun scripts/setup-server.ts",
    "server:throwaway": "bun scripts/throwaway-server.ts",
    "navmesh:build": "bun scripts/build-navmesh.ts",
    "terrain:build": "bun scripts/build-terrain.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
